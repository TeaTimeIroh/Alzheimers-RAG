# Copy this file to .env and fill it in. .env is in .gitignore - never commit your API key.

# --- Option A: LM Studio (local, free). Load a model, then Developer tab -> Start server.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-coder-30b-a3b-instruct
LLM_API_KEY=lm-studio

# --- Option B: Gemini (free tier; prompts may be used by Google to improve its products)
# Key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=models/gemini-3.1-flash-lite
# LLM_API_KEY=your-key-here

# Set LLM_MODEL to an id printed by:  python answer.py --list-models
# (if left empty, the first listed model is used - which may be an embedding model)

# Seconds before giving up on a (slow, local) model:
LLM_TIMEOUT=300

# Search mode: hybrid (default: embeddings + Postgres full-text, fused), vector or keyword.
# Command-line --retrieval and the API's mode/retrieval fields override it.
# RETRIEVAL=hybrid

# Database (matches docker-compose.yml)
# DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# --- Judge (judge.py): a separate, stronger model grades the saved answers afterwards.
# Independent of LLM_* above, so a Qwen run can still be judged by Gemini.
# Free-tier quotas are per model: AI Studio -> Usage / rate limits shows yours.
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUDGE_MODEL=models/gemini-3.8-flash
# JUDGE_API_KEY=your-key-here
# How much the judge thinks before answering (low / medium / high; empty = model default,
# which can take minutes per call). Seconds before giving up on one call:
# JUDGE_REASONING=low
# JUDGE_TIMEOUT=300

# --- API access (api.py / auth.py): /search and /ask need an X-API-Key header.
# Create keys with:  python auth.py create <name> --scopes search,ask
# API_KEYS_FILE=api_keys.json
# API_AUTH=off      # disables the key check - local experiments only
